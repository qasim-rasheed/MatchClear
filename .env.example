# Copy to .env.local. Never put real credentials in a tracked file.
YOUCAM_API_KEY=
# V3 bearer authentication uses the API key. The issued secret is not needed by this adapter.
MATCHCLEAR_DATA_DIR=.local
MATCHCLEAR_API_UNIT_LIMIT=40
# Optional, only for the explicitly invoked feasibility CLI. Supply your own permitted files.
MATCHCLEAR_PERSON_PHOTO=
MATCHCLEAR_GARMENT_PHOTO=
MATCHCLEAR_PHOTO_PERMISSION_CONFIRMED=false
